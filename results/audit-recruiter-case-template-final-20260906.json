ents":[],"widgetType":"button"}],"isInner":false}],"document_type":"single-post","edit_mode":"builder","template_type":"single-post","page_settings":[],"conditions":[],"elementor_version":"4.2.4"},"fingerprint":"6df38f559fca75522f010458eb17811d5f4bf4888f6e7fa42a88d5333f4cc794"}},{"action":"post.get","result":{"post":{"id":4626,"type":"elementor_library","status":"draft","title":"Recruiter Case Study - Static Prototype","slug":"recruiter-case-study-static-prototype","content":"<p style=\"margin:0;text-transform:uppercase;letter-spacing:.12em;font-weight:700\">Selected case \u00b7 WordPress \/ WooCommerce<\/p>\t\t\t<h1>Byderma \u2014 a clearer path between treatments, shopping and booking<\/h1>\t\t<p>A WordPress and WooCommerce beauty platform that keeps treatment discovery, product shopping and appointment booking easy to distinguish while maintaining one consistent experience across desktop and mobile.<\/p>\t\t\t\t\t\t\t\t<a href=\"https:\/\/andrewbaeten.nl\/cases\/\">\n\t\t\t\t\t\t\t\t\tView all cases\n\t\t\t\t\t<\/a>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t<a href=\"mailto:info@andrewbaeten.nl\">\n\t\t\t\t\t\t\t\t\tContact me\n\t\t\t\t\t<\/a>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<img width=\"2560\" height=\"1920\" src=\"https:\/\/andrewbaeten.nl\/wp-content\/uploads\/2026\/04\/byderma-desktop-homepage-1.png\" alt=\"Byderma webshop homepage shown on desktop\" srcset=\"https:\/\/andrewbaeten.nl\/wp-content\/uploads\/2026\/04\/byderma-desktop-homepage-1.png 2560w, https:\/\/andrewbaeten.nl\/wp-content\/uploads\/2026\/04\/minimalistic-macbook-pro-mockup-10-3-300x225.png 300w, https:\/\/andrewbaeten.nl\/wp-content\/uploads\/2026\/04\/minimalistic-macbook-pro-mockup-10-3-1024x768.png 1024w, https:\/\/andrewbaeten.nl\/wp-content\/uploads\/2026\/04\/minimalistic-macbook-pro-mockup-10-3-768x576.png 768w, https:\/\/andrewbaeten.nl\/wp-content\/uploads\/2026\/04\/minimalistic-macbook-pro-mockup-10-3-1536x1152.png 1536w\" sizes=\"(max-width: 2560px) 100vw, 2560px\" \/>\t\t\t\t\t\t\t\t\t\t\t\t\t<p style=\"margin:0;text-transform:uppercase;letter-spacing:.08em;font-weight:700\">Role<\/p>\t\t\tWordPress Developer\t\t<p style=\"margin:0;text-transform:uppercase;letter-spacing:.08em;font-weight:700\">Platform<\/p>\t\t\tWordPress + WooCommerce\t\t<p style=\"margin:0;text-transform:uppercase;letter-spacing:.08em;font-weight:700\">Focus<\/p>\t\t\tUX \u00b7 Ecommerce \u00b7 Responsive\t\t<p style=\"margin:0;text-transform:uppercase;letter-spacing:.08em;font-weight:700\">Journeys<\/p>\t\t\tTreatments \u00b7 Shop \u00b7 Booking\t\t<p style=\"margin:0;text-transform:uppercase;letter-spacing:.1em;font-weight:700\">01 \u00b7 The challenge<\/p>\t\t\t<h2>Three different user intents, one coherent website<\/h2>\t\t<p>The site supports visitors who want to discover treatments, buy products or book an appointment. Those journeys need to feel connected, but they should never compete for attention or become confusing.<\/p>\t\t\t<h3>Clear task separation<\/h3>\t\t<p>Treatments, shopping and booking stay recognizable as separate tasks.<\/p>\t\t\t<h3>Responsive hierarchy<\/h3>\t\t<p>The same distinction remains clear on smaller screens without adding extra complexity.<\/p>\t\t\t<h3>Supporting content<\/h3>\t\t<p>Account and membership content stays accessible without interrupting the main treatment, shopping and booking journeys.<\/p><p style=\"margin:0;text-transform:uppercase;letter-spacing:.1em;font-weight:700\">02 \u00b7 My contribution<\/p>\t\t\t<h2>I structured the experience around separate user tasks<\/h2>\t\t<p>I structured the WordPress and WooCommerce experience around treatment discovery, shopping and appointment booking. Each journey stays focused, while account and membership content remains accessible without interrupting the main tasks.<\/p><p style=\"margin:0;font-weight:700\">01<\/p>\t\t\t<h3>Structure &amp; UX<\/h3>\t\t<p>I separated treatment discovery, shopping and booking into distinct paths so each task stays easy to understand.<\/p><p style=\"margin:0;font-weight:700\">02<\/p>\t\t\t<h3>WordPress build<\/h3>\t\t<p>Treatment information leads naturally to appointments, while the WooCommerce shop keeps product discovery and purchasing focused.<\/p><p style=\"margin:0;font-weight:700\">03<\/p>\t\t\t<h3>Mobile hierarchy<\/h3>\t\t<p>On smaller screens, the same hierarchy remains clear without merging the different tasks.<\/p><p style=\"margin:0;text-transform:uppercase;letter-spacing:.1em;font-weight:700\">03 \u00b7 Technical thinking<\/p>\t\t\t<h2>Built for editing, consistency and growth<\/h2>\t\t<p>The implementation centers on WordPress and WooCommerce, with the content hierarchy separating treatments, ecommerce and appointment booking.<\/p><p><strong style=\"color:#F9C221\">Stack<\/strong><br>WordPress \u00b7 WooCommerce<\/p><p><strong style=\"color:#F9C221\">Implementation priorities<\/strong><br>Task separation \u00b7 clear product discovery \u00b7 appointment routes \u00b7 mobile hierarchy<\/p><p><strong style=\"color:#F9C221\">Case focus<\/strong><br>Beauty treatments \u00b7 ecommerce \u00b7 membership content \u00b7 booking<\/p><p style=\"margin:0;text-transform:uppercase;letter-spacing:.1em;font-weight:700\">04 \u00b7 Takeaway<\/p>\t\t\t<h2>What this case demonstrates<\/h2>\t\t<p>This case demonstrates how I structure a WordPress and WooCommerce platform around several user goals, keeping treatment discovery, shopping and booking distinct while maintaining one consistent experience.<\/p><p style=\"margin:0;text-align:center;text-transform:uppercase;letter-spacing:.1em;font-weight:700\">Open to WordPress opportunities<\/p>\t\t\t<h2>Looking for a WordPress developer who combines structure, UX and implementation?<\/h2>\t\t<p style=\"text-align:center\">I work across WordPress, WooCommerce, Elementor, UX and performance, with a focus on clear structure and maintainable delivery.<\/p>\t\t\t\t\t\t\t\t<a href=\"mailto:info@andrewbaeten.nl\">\n\t\t\t\t\t\t\t\t\tStart a conversation\n\t\t\t\t\t<\/a>","excerpt":"","author":1,"parent":0,"menu_order":0,"date":"2026-09-06 21:58:05","date_gmt":"0000-00-00 00:00:00","modified":"2026-09-06 21:58:05","modified_gmt":"2026-09-06 21:58:05","comment_status":"closed","ping_status":"closed","password_protected":"[redacted]","featured_media":0,"permalink":"https:\/\/andrewbaeten.nl\/?post_type=elementor_library&p=4626"},"fingerprint":"931325d65d76e36a6b5845cbf4701320680b019072e6834745c2460ffd60d328"}}]},"meta":{"request_fingerprint":"26e779cc4db4d8ec73790f38806ea4eb22f37cc82e3c14f2763fb24786acede0"}}