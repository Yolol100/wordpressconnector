{
  "name": "webactueel/wordpressconnector-phpstan-tools",
  "type": "project",
  "description": "Development-only PHPStan provider type definitions, not bundled with the WordPress plugin.",
  "require": {
    "php": ">=8.0"
  },
  "require-dev": {
    "phpstan/phpstan": "2.2.6",
    "szepeviktor/phpstan-wordpress": "2.0.3",
    "php-stubs/wordpress-stubs": "6.9.4",
    "php-stubs/woocommerce-stubs": "11.1.2",
    "php-stubs/acf-pro-stubs": "6.8.2",
    "php-stubs/wp-cli-stubs": "2.12.0"
  },
  "config": {
    "allow-plugins": false,
    "sort-packages": true
  }
}
