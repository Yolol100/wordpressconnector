{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Yolol100/wordpressconnector/schemas/request.schema.json",
  "title": "WordPress Connector Request",
  "type": "object",
  "required": ["request_id", "action", "payload"],
  "additionalProperties": false,
  "properties": {
    "version": {"type": "integer", "const": 1, "default": 1},
    "request_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{7,99}$"},
    "action": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "dry_run": {"type": "boolean", "default": true},
    "confirm": {"type": "boolean", "default": false},
    "expected_fingerprint": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "payload": {"type": "object"}
  }
}
